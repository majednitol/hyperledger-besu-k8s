#!/bin/bash
# ========================
# Besu Dual-Network Configuration
# Single source of truth — all deploy scripts source this file
# ========================

# --- Organizations (RIRs + coordinator) ---
ORG_NAMES=("afrinic" "apnic" "rono")
ORG_COUNT=${#ORG_NAMES[@]}

# --- Kubernetes Namespaces ---
PRIVATE_NAMESPACE="besu-private"
PUBLIC_NAMESPACE="besu-public"
APP_NAMESPACE="besu-app"

# --- Private Network ---
PRIVATE_CHAIN_ID=78901
PRIVATE_VALIDATOR_COUNT=4    # 2 RIRs + rono coordinator + rono-2

PRIVATE_BLOCK_PERIOD=5       # seconds between blocks
PRIVATE_EMPTY_BLOCK_PERIOD=60
PRIVATE_P2P_PORT=30303
PRIVATE_RPC_PORT=8545
PRIVATE_METRICS_PORT=9545

# --- Public Network ---
PUBLIC_CHAIN_ID=78902
PUBLIC_VALIDATOR_COUNT=5     # consortium-seeded, documented governance for adding new sealers
PUBLIC_BLOCK_PERIOD=5
PUBLIC_EMPTY_BLOCK_PERIOD=60
PUBLIC_P2P_PORT=30303
PUBLIC_RPC_PORT=8545
PUBLIC_METRICS_PORT=9545

# --- Consensus Parameters (shared by both genesis files) ---
EPOCH_LENGTH=30000
REQUEST_TIMEOUT_SECONDS=10

# --- Bootnode Configuration ---
PRIVATE_BOOTNODE_COUNT=2     # 2 bootnodes for discovery-path HA
PUBLIC_BOOTNODE_COUNT=2      # 2 public bootnodes (master plan Section 6.1 recommends 2+ for join-path redundancy)
# PUBLIC_BOOTNODE_ENODE="enode://<pubkey>@bootnode.public.<domain>:30303"  # Set after Phase 6 bootnode deployment

# --- Container Images (pinned by digest for production) ---
BESU_IMAGE="hyperledger/besu:24.12.2"
# TODO Phase 3: Pin by digest: BESU_IMAGE="hyperledger/besu@sha256:<digest>"
# To get digest: docker pull hyperledger/besu:24.12.2 && docker inspect --format='{{.RepoDigests}}' hyperledger/besu:24.12.2

# --- Bridge ---
ANCHOR_INTERVAL_SECONDS=600  # 10 minutes between anchor submissions

# --- Resource Sizing (scaled down for local Minikube cluster) ---
VALIDATOR_CPU_REQUEST="100m"
VALIDATOR_CPU_LIMIT="500m"
VALIDATOR_MEM_REQUEST="256Mi"
VALIDATOR_MEM_LIMIT="2048Mi"
VALIDATOR_DISK="1Gi"

RPC_CPU_REQUEST="100m"
RPC_CPU_LIMIT="500m"
RPC_MEM_REQUEST="256Mi"
RPC_MEM_LIMIT="2048Mi"

BOOTNODE_CPU_REQUEST="100m"
BOOTNODE_CPU_LIMIT="500m"
BOOTNODE_MEM_REQUEST="256Mi"
BOOTNODE_MEM_LIMIT="2048Mi"

# --- Permissioning Contract Addresses (private network genesis alloc) ---
NODE_INGRESS_ADDRESS="0x0000000000000000000000000000000000009999"
ACCOUNT_INGRESS_ADDRESS="0x0000000000000000000000000000000000008888"

# --- Secrets Backend ---
SECRETS_BACKEND="k8s-native"  # Options: k8s-native | aws-secrets-manager | azure-keyvault | gcp-secret-manager

# --- Domain (for public Ingress, Phase 5+) ---
# PUBLIC_DOMAIN="your-domain.com"
